# ==============================================================================
# AI Business Command Center — Environment Variables Template
# Architecture: v2.2 Final
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in your actual credentials for local development.
# 3. DO NOT commit .env.local or expose sensitive API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth (Required in Phase 1+)
# ------------------------------------------------------------------------------
# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key (Safe for browser client, constrained by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Secret service-role key (SERVER-ONLY: Bypasses RLS. NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Base URL of the application (used for auth redirect callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Vercel AI SDK 7.0 Engine Configuration (Required in Phase 5)
# ------------------------------------------------------------------------------
# AI Execution Mode:
# - "mock": Zero-cost local development using deterministic simulated responses
# - "live": Connects to live Gemini, Anthropic, or OpenAI models via official SDKs
AI_MODE="mock"

# Active AI Provider when AI_MODE="live" ("gemini", "anthropic", or "openai")
AI_PROVIDER="gemini"

# Google Gemini Configuration (Official @google/genai SDK)
GEMINI_API_KEY=""
# Configurable model ID (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Anthropic Configuration
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key"
# Configurable model ID (e.g. claude-sonnet-5, claude-opus-5, claude-haiku-4-5)
ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-your-openai-key"
# Configurable model ID (e.g. gpt-5.6-sol, gpt-5.6-terra, gpt-5.5)
OPENAI_MODEL="gpt-5.6-sol"

# ------------------------------------------------------------------------------
# 3. Knowledge Base / RAG Configuration (Required in Phase 12)
# ------------------------------------------------------------------------------
# Provider for embedding ("openai" or "mock")
EMBEDDING_PROVIDER="mock"

# When using OpenAI, the embedding model to use (e.g., text-embedding-3-small)
EMBEDDING_MODEL="text-embedding-3-small"

# The vector dimension MUST match the database vector column exactly.
# For text-embedding-3-small, this is typically 1536.
# If using a mock provider, the mock embeddings will be generated to this exact length.
EMBEDDING_DIMENSION="1536"
